{
  "name": "sketchflow",
  "version": "0.1.0",
  "description": "A canvas with a notes editor beside it. Every save is a Git commit to a GitHub repository you own.",
  "license": "MIT",
  "homepage": "https://sketchflow.space",
  "repository": {
    "type": "git",
    "url": "https://github.com/playlikeboy/sketchflow.git"
  },
  "bugs": {
    "url": "https://github.com/playlikeboy/sketchflow/issues"
  },
  "keywords": [
    "sketchflow",
    "excalidraw",
    "whiteboard",
    "diagrams",
    "visual-workspace",
    "markdown",
    "notes",
    "github",
    "git",
    "offline-first",
    "local-first",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "cloudflare-workers",
    "open-source"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun run lint && bun run typecheck && bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@blocknote/shadcn": "0.51.4",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.19.9",
    "@stackframe/stack": "^2.8.95",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "server-only": "^0.0.1",
    "shadcn": "^4.8.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "wrangler": "^4.93.1"
  }
}
