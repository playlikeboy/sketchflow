# ==========================================
# Better Auth (https://www.better-auth.com)
# ==========================================
# Encrypts the session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
# Public origin of this deployment. Leave unset for local development on any port.
# BETTER_AUTH_URL=https://your-domain.example

# ==========================================
# GitHub OAuth App (https://github.com/settings/developers)
# ==========================================
# Authorization callback URL: <origin>/api/auth/callback/github
# A GitHub OAuth App has one callback URL, so use a separate app for local development.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ==========================================
# Neon Postgres Database (https://neon.tech)
# ==========================================
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/sketchflow?sslmode=require

# ==========================================
# Application & GitHub Configuration
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
GITHUB_API_VERSION=2022-11-28
GITHUB_OAUTH_SCOPES=repo,read:user,user:email

SKETCHFLOW_REPO_NAME=sketchflow-workspace
SKETCHFLOW_DEFAULT_BRANCH=main
